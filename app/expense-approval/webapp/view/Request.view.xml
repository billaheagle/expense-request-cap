<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    controllerName="expenseapproval.controller.Request"
>
    <Shell id="idRequestShell">
        <Page
            id="idCreateExpensePage"
            title="Create Expense"
            showNavButton="true"
            navButtonPress=".onPageCreateExpenseNavButtonPress"
        >
            <content>
                <Panel
                    id="idExpenseRequestPanel"
                    headerText="Expense Request"
                    class="sapUiResponsiveMargin"
                    width="auto"
                    expanded="true"
                >
                    <form:SimpleForm
                        id="idExpenseSimpleForm"
                        editable="true"
                    >
                        <form:content>
                            <Label
                                id="idCurrencyLabel"
                                text="Currency"
                            />
                            <Input
                                id="idCurrencyInput"
                                value="{header>/Currency}"
                                placeholder="e.g., USD"
                                width="15%"
                                valueState="{header>/_CurrencyState}"
                                valueStateText="Currency is required"
                                liveChange=".onCurrencyInputLiveChange"
                                showValueHelp="true"
                                valueHelpRequest=".onCurrencyInputValueHelpRequest"
                            />

                            <Label
                                id="idExpenseNotesLabel"
                                text="Expense Notes"
                            />
                            <TextArea
                                id="idExpenseNotesTextArea"
                                placeholder="Enter expense details here..."
                                value="{header>/ExpenseNotes}"
                                valueState="{header>/_ExpenseNotesState}"
                                valueStateText="Expense Notes is required"
                                liveChange=".onExpenseNotesTextAreaLiveChange"
                                rows="4"
                                width="50%"
                                growing="true"
                                growingMaxLines="6"
                                maxLength="255"
                                showExceededText="true"
                            />
                        </form:content>
                    </form:SimpleForm>

                    <HBox
                        id="idActionButtonsHBox"
                        justifyContent="End"
                        class="sapUiSmallMarginTop"
                    >
                        <Button
                            id="idSaveAsDraftButton"
                            text="Save as Draft"
                            press=".onSaveAsDraftButtonPress"
                            icon="sap-icon://save"
                            enabled="{= ${header>/_isValid} === true }"
                        />
                        <Button
                            id="idSubmitRequestButton"
                            text="Submit Request"
                            press=".onSubmitRequestButtonPress"
                            class="sapUiSmallMarginBegin"
                            icon="sap-icon://action"
                            type="Emphasized"
                            enabled="{= ${header>/_isValidItem} === true }"
                        />
                    </HBox>
                </Panel>

                <Panel
                    id="idExpenseItemsPanel"
                    headerText="Expense Items"
                    class="sapUiResponsiveMargin"
                    width="auto"
                    expanded="true"
                >
                    <Table
                        id="idItemsTable"
                        items="{items>/items}"
                        mode="MultiSelect"
                    >
                        <headerToolbar>
                            <Toolbar id="idItemsToolbar">
                                <ToolbarSpacer id="idItemsToolbarSpacer" />
                                <Button
                                    id="idAddNewItemButton"
                                    text="Add New Item"
                                    icon="sap-icon://add"
                                    press=".onAddNewItemButtonPress"
                                    type="Ghost"
                                />
                            </Toolbar>
                        </headerToolbar>

                        <columns>
                            <Column id="idTypeColumn">
                                <Text
                                    id="idTypeColumnHeaderText"
                                    text="Type"
                                />
                            </Column>
                            <Column id="idDateColumn">
                                <Text
                                    id="idDateColumnHeaderText"
                                    text="Date"
                                />
                            </Column>
                            <Column id="idAmountColumn">
                                <Text
                                    id="idAmountColumnHeaderText"
                                    text="Amount"
                                />
                            </Column>
                            <Column id="idDescriptionColumn">
                                <Text
                                    id="idDescriptionColumnHeaderText"
                                    text="Description"
                                />
                            </Column>
                            <Column
                                id="idActionColumn"
                                hAlign="Center"
                            >
                                <Text
                                    id="idActionColumnHeaderText"
                                    text="Action"
                                />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="idItemsColumnListItem">
                                <cells>
                                    <Text
                                        id="idExpenseTypeCodeText"
                                        text="{items>ExpenseType_Code}"
                                    />
                                    <Text
                                        id="idExpenseDateText"
                                        text="{path: 'items>ExpenseDate', formatter: '.formatDate'}"
                                    />
                                    <Text
                                        id="idAmountText"
                                        text="{items>Amount}"
                                    />
                                    <Text
                                        id="idDescriptionText"
                                        text="{items>Description}"
                                    />

                                    <HBox
                                        id="idItemActionsHBox"
                                        justifyContent="Center"
                                        alignItems="Center"
                                        class="sapUiTinyMargin"
                                    >
                                        <Button
                                            id="idEditItemButton"
                                            type="Attention"
                                            icon="sap-icon://edit"
                                            press=".onButtonEditItemPress"
                                        />
                                        <Button
                                            id="idDeleteItemButton"
                                            type="Reject"
                                            icon="sap-icon://delete"
                                            press=".onButtonDeleteItemPress"
                                            class="sapUiTinyMarginBegin"
                                        />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </content>
        </Page>
    </Shell>
</mvc:View>
