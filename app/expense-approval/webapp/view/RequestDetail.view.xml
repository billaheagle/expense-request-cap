<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:form="sap.ui.layout.form"
    xmlns="sap.m"
    controllerName="expenseapproval.controller.RequestDetail"
>
    <Page
        id="idRequestDetailPage"
        title="{i18n>requestDetailTitle}"
        showNavButton="true"
        navButtonPress=".onPageRequestDetailNavButtonPress"
    >
        <content>
            <Panel
                id="idRequestDetailHeaderPanel"
                headerText="{i18n>requestContentTitle}"
                class="sapUiResponsiveMargin"
                width="auto"
                expanded="true"
            >
                <form:SimpleForm
                    id="idRequestDetailSimpleForm"
                    editable="false"
                >
                    <form:content>
                        <Label
                            id="idDetailRequestNumberLabel"
                            text="{i18n>labelRequestNumber}"
                            visible="{= ${path: 'header>/Status', targetType: 'any'} !== 'Draft' }"
                        />
                        <Text
                            id="idDetailRequestNumberText"
                            text="{header>/RequestNumber}"
                            visible="{= ${path: 'header>/Status', targetType: 'any'} !== 'Draft' }"
                        />

                        <Label
                            id="idDetailCurrencyLabel"
                            text="{i18n>labelCurrency}"
                        />
                        <Text
                            id="idDetailCurrencyText"
                            text="{header>/Currency}"
                        />

                        <Label
                            id="idDetailExpenseNotesLabel"
                            text="{i18n>labelExpenseNotes}"
                        />
                        <Text
                            id="idDetailExpenseNotesText"
                            text="{header>/ExpenseNotes}"
                        />

                        <Label
                            id="idDetailTotalRequestedAmountLabel"
                            text="{i18n>labelTotalRequestedAmount}"
                        />
                        <ObjectNumber
                            id="idDetailTotalRequestedAmountObjectNumber"
                            number="{
                                path: 'header>/TotalRequestedAmount',
                                type: 'sap.ui.model.odata.type.Decimal',
                                formatOptions: {
                                    minFractionDigits: 2,
                                    maxFractionDigits: 2
                                }
                            }"
                            unit="{header>/Currency}"
                        />

                        <Label
                            id="idDetailTotalAcceptedAmountLabel"
                            text="{i18n>labelTotalAcceptedAmount}"
                            visible="{= ${path: 'Status', targetType: 'any'} === 'Reimbursed' }"
                        />
                        <ObjectNumber
                            id="idDetailTotalAcceptedAmountObjectNumber"
                            number="{
                                path: 'header>/TotalAcceptedAmount',
                                type: 'sap.ui.model.odata.type.Decimal',
                                formatOptions: {
                                    minFractionDigits: 2,
                                    maxFractionDigits: 2
                                }
                            }"
                            unit="{header>/Currency}"
                            visible="{= ${path: 'Status', targetType: 'any'} === 'Reimbursed' }"
                        />

                        <Label
                            id="idDetailStatusLabel"
                            text="{i18n>labelStatus}"
                        />
                        <ObjectStatus
                            id="idDetailStatusObjectStatus"
                            text="{header>/Status}"
                            state="{path: 'header>/Status', formatter: '.formatStatusState'}"
                        />

                        <Label
                            id="idDetailReasonLabel"
                            text="{i18n>labelReason}"
                            visible="{= ${path: 'header>/Status', targetType: 'any'} === 'Rejected' }"
                        />
                        <Text
                            id="idDetailReasonText"
                            text="{header>/Reason}"
                            visible="{= ${path: 'header>/Status', targetType: 'any'} === 'Rejected' }"
                        />
                    </form:content>
                </form:SimpleForm>

                <HBox
                    id="idDetailActionButtonsHBox"
                    justifyContent="End"
                    class="sapUiSmallMarginTop"
                >
                    <Button
                        id="idDetailApproveButton"
                        text="{i18n>btnApprove}"
                        press=".onApproveButtonPress"
                        icon="sap-icon://accept"
                        type="Success"
                        visible="{= ${user>/Roles}.indexOf('manager') >= 0 &amp;&amp; ( ${path: 'header>/Status', targetType: 'any'} === 'Submitted' || ${path: 'header>/Status', targetType: 'any'} === 'Inprogress' ) }"
                        enabled="{= ${user>/Roles}.indexOf('manager') >= 0 &amp;&amp; ( ${path: 'header>/Status', targetType: 'any'} === 'Submitted' || ${path: 'header>/Status', targetType: 'any'} === 'Inprogress' ) }"
                    />
                    <Button
                        id="idDetailDeclineButton"
                        text="{i18n>btnDecline}"
                        press=".onDeclineButtonPress"
                        class="sapUiSmallMarginBegin"
                        icon="sap-icon://decline"
                        type="Reject"
                        visible="{= ${user>/Roles}.indexOf('manager') >= 0 &amp;&amp; ( ${path: 'header>/Status', targetType: 'any'} === 'Submitted' || ${path: 'header>/Status', targetType: 'any'} === 'Inprogress' ) }"
                        enabled="{= ${user>/Roles}.indexOf('manager') >= 0 &amp;&amp; ( ${path: 'header>/Status', targetType: 'any'} === 'Submitted' || ${path: 'header>/Status', targetType: 'any'} === 'Inprogress' ) }"
                    />
                    <Button
                        id="idDetailReimburseButton"
                        text="{i18n>btnReimburse}"
                        press=".onReimburseButtonPress"
                        class="sapUiSmallMarginBegin"
                        icon="sap-icon://money-bills"
                        type="Accept"
                        visible="{= ${user>/Roles}.indexOf('finance') >= 0 &amp;&amp; ${path: 'header>/Status', targetType: 'any'} === 'Approved' }"
                        enabled="{= ${user>/Roles}.indexOf('finance') >= 0 &amp;&amp; ${path: 'header>/Status', targetType: 'any'} === 'Approved' }"
                    />
                    <Button
                        id="idDetailEditButton"
                        text="{i18n>btnEdit}"
                        press=".onEditButtonPress"
                        class="sapUiSmallMarginBegin"
                        icon="sap-icon://edit"
                        type="Emphasized"
                        visible="{= ${user>/Roles}.indexOf('employee') >= 0 &amp;&amp; ${path: 'header>/Status', targetType: 'any'} === 'Draft' }"
                        enabled="{= ${user>/Roles}.indexOf('employee') >= 0 &amp;&amp; ${path: 'header>/Status', targetType: 'any'} === 'Draft' }"
                    />
                    <Button
                        id="idDetailDeleteButton"
                        text="{i18n>btnDelete}"
                        press=".onDeleteButtonPress"
                        class="sapUiSmallMarginBegin"
                        icon="sap-icon://delete"
                        type="Negative"
                        visible="{= ${user>/Roles}.indexOf('employee') >= 0 &amp;&amp; ${path: 'header>/Status', targetType: 'any'} === 'Draft' }"
                        enabled="{= ${user>/Roles}.indexOf('employee') >= 0 &amp;&amp; ${path: 'header>/Status', targetType: 'any'} === 'Draft' }"
                    />
                </HBox>
            </Panel>

            <Panel
                id="idRequestDetailItemsPanel"
                headerText="{i18n>requestExpenseItemContentTitle}"
                class="sapUiResponsiveMargin"
                width="auto"
                expanded="true"
            >
                <Table
                    id="idRequestDetailItemsTable"
                    items="{items>/items}"
                >
                    <columns>
                        <Column id="idDetailTypeColumn">
                            <Text
                                id="idDetailTypeColumnHeaderText"
                                text="{i18n>columnExpenseType}"
                            />
                        </Column>
                        <Column id="idDetailDateColumn">
                            <Text
                                id="idDetailDateColumnHeaderText"
                                text="{i18n>columnDate}"
                            />
                        </Column>
                        <Column id="idDetailAmountColumn">
                            <Text
                                id="idDetailAmountColumnHeaderText"
                                text="{i18n>columnAmount}"
                            />
                        </Column>
                        <Column id="idDetailDescriptionColumn">
                            <Text
                                id="idDetailDescriptionColumnHeaderText"
                                text="{i18n>columnDescription}"
                            />
                        </Column>
                        <Column id="idDetailJustificationColumn">
                            <Text
                                id="idDetailJustificationColumnHeaderText"
                                text="{i18n>columnJustification}"
                            />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem id="idDetailItemsColumnListItem">
                            <cells>
                                <Text
                                    id="idDetailExpenseTypeCodeText"
                                    text="{items>ExpenseType_Code}"
                                />
                                <Text
                                    id="idDetailExpenseDateText"
                                    text="{path: 'items>ExpenseDate', formatter: '.formatDate'}"
                                />
                                <Text
                                    id="idDetailAmountText"
                                    text="{items>Amount}"
                                />
                                <Text
                                    id="idDetailDescriptionText"
                                    text="{items>Description}"
                                />
                                <Text
                                    id="idDetailJustificationText"
                                    text="{items>Justification}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>