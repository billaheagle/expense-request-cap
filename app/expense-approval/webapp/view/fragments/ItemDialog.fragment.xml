<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="idItemDialog"
        title="Expense Item Details"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content sapUiResponsivePadding--footer"
    >
        <content>
            <VBox
                id="idItemDialogVBox"
                class="sapUiSmallMargin"
            >
                <Label
                    id="idExpenseTypeIDLabel"
                    text="Expense Type ID"
                />
                <Input
                    id="idExpenseTypeCodeInput"
                    value="{item>/ExpenseType_Code}"
                    showValueHelp="true"
                    valueHelpRequest=".onExpenseTypeCodeInputValueHelpRequest"
                    valueState="{item>/_ExpenseType_CodeState}"
                    valueStateText="Expense Type is required"
                    liveChange=".onExpenseTypeCodeInputLiveChange"
                    width="100%"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    id="idDateLabel"
                    text="Date"
                />
                <DatePicker
                    id="idExpenseDateDatePicker"
                    value="{item>/ExpenseDate}"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd/MM/yyyy"
                    valueState="{item>/_ExpenseDateState}"
                    valueStateText="ExpenseDate is required"
                    change=".onExpenseDateDatePickerChange"
                    width="100%"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    id="idAmountLabel"
                    text="Amount"
                />
                <Input
                    id="idAmountInput"
                    value="{item>/Amount}"
                    valueState="{item>/_AmountState}"
                    valueStateText="Amount is required"
                    liveChange=".onAmountInputLiveChange"
                    width="100%"
                    class="sapUiSmallMarginBottom"
                    type="Number"
                />

                <Label
                    id="idDescriptionLabel"
                    text="Description"
                />
                <TextArea
                    id="idDescriptionTextArea"
                    placeholder="Enter expense details here..."
                    value="{item>/Description}"
                    rows="4"
                    width="100%"
                    growing="true"
                    growingMaxLines="6"
                    maxLength="255"
                    showExceededText="true"
                />

                <HBox
                    id="idItemDialogHBox"
                    justifyContent="End"
                    class="sapUiSmallMarginTop"
                >
                    <Button
                        id="idCancelItemDialogButton"
                        text="Cancel"
                        press=".onCancelButtonItemDialogPress"
                        type="Reject"
                    />
                    <Button
                        id="idSaveItemDialogButton"
                        text="Save"
                        press=".onSaveButtonItemDialogPress"
                        class="sapUiSmallMarginBegin"
                        type="Accept"
                        enabled="{= ${item>/_isValid} === true }"
                    />
                </HBox>
            </VBox>
        </content>
    </Dialog>
</core:FragmentDefinition>
