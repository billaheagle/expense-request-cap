<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="idItemDialog"
        title="{i18n>popupExpenseItemTitle}"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content sapUiResponsivePadding--footer"
    >
        <content>
            <VBox
                id="idItemDialogVBox"
                class="sapUiSmallMargin"
            >
                <Label
                    id="idExpenseTypeIDLabel"
                    text="{i18n>labelExpenseType}"
                />
                <Input
                    id="idExpenseTypeCodeInput"
                    value="{item>/ExpenseType_Code}"
                    showValueHelp="true"
                    valueHelpRequest=".onExpenseTypeCodeInputValueHelpRequest"
                    valueState="{item>/_ExpenseType_CodeState}"
                    valueStateText="{i18n>valueStateExpenseType}"
                    valueLiveUpdate="true"
                    liveChange=".onExpenseTypeCodeInputLiveChange"
                    width="100%"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    id="idDateLabel"
                    text="{i18n>labelDate}"
                />
                <DatePicker
                    id="idExpenseDateDatePicker"
                    value="{item>/ExpenseDate}"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd/MM/yyyy"
                    valueState="{item>/_ExpenseDateState}"
                    valueStateText="{i18n>valueStateExpenseDate}"
                    change=".onExpenseDateDatePickerChange"
                    width="100%"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    id="idAmountLabel"
                    text="{i18n>labelAmount}"
                />
                <Input
                    id="idAmountInput"
                    value="{item>/Amount}"
                    valueState="{item>/_AmountState}"
                    valueStateText="{i18n>valueStateAmount}"
                    valueLiveUpdate="true"
                    liveChange=".onAmountInputLiveChange"
                    width="100%"
                    class="sapUiSmallMarginBottom"
                    type="Number"
                />

                <Label
                    id="idDescriptionLabel"
                    text="{i18n>labelDescription}"
                />
                <TextArea
                    id="idDescriptionTextArea"
                    placeholder="{i18n>placeholderDescription}"
                    value="{item>/Description}"
                    valueLiveUpdate="true"
                    rows="4"
                    width="100%"
                    growing="true"
                    growingMaxLines="6"
                    maxLength="255"
                    showExceededText="true"
                />

                <HBox
                    id="idItemDialogHBox"
                    justifyContent="End"
                    class="sapUiSmallMarginTop"
                >
                    <Button
                        id="idCancelItemDialogButton"
                        text="{i18n>btnCancel}"
                        press=".onCancelButtonItemDialogPress"
                        type="Default"
                    />
                    <Button
                        id="idSaveItemDialogButton"
                        text="{i18n>btnSave}"
                        press=".onSaveButtonItemDialogPress"
                        class="sapUiSmallMarginBegin"
                        type="Accept"
                        enabled="{= ${item>/_isValid} === true }"
                    />
                </HBox>
            </VBox>
        </content>
    </Dialog>
</core:FragmentDefinition>
