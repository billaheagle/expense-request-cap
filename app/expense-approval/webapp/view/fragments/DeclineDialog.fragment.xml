<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="idDeclineDialog"
        title="{i18n>popupDeclineTitle}"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content sapUiResponsivePadding--footer"
    >
        <content>
            <VBox
                id="idDeclineDialogVBox"
                class="sapUiSmallMargin"
            >
                <Label
                    id="idReasonLabel"
                    text="{i18n>labelReason}"
                />
                <Input
                    id="idReasonInput"
                    value="{decline>/Reason}"
                    valueState="{decline>/_ReasonState}"
                    valueStateText="{i18n>valueStateReason}"
                    valueLiveUpdate="true"
                    liveChange=".onReasonInputLiveChange"
                    width="100%"
                    class="sapUiSmallMarginBottom"
                    type="Text"
                    placeholder="{i18n>placeholderReason}"
                />

                <HBox
                    id="idDeclineDialogHBox"
                    justifyContent="End"
                    class="sapUiSmallMarginTop"
                >
                    <Button
                        id="idCancelDeclineDialogButton"
                        text="{i18n>btnCancel}"
                        press=".onCancelButtonDeclineDialogPress"
                        type="Default"
                    />
                    <Button
                        id="idSaveDeclineDialogButton"
                        text="{i18n>btnDecline}"
                        press=".onDeclineButtonDeclineDialogPress"
                        class="sapUiSmallMarginBegin"
                        type="Reject"
                        enabled="{= ${decline>/_isValid} === true }"
                    />
                </HBox>
            </VBox>
        </content>
    </Dialog>
</core:FragmentDefinition>
