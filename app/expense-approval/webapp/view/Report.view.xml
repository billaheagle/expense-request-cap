<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="expenseapproval.controller.Report"
>
    <Page
        id="idReportPage"
        title="{= ${user>/Roles}.indexOf('finance') >= 0
                ? ${i18n>reportTitleFinance}
                : ${user>/Roles}.indexOf('manager') >= 0
                    ? ${i18n>reportTitleManager}
                    : ${i18n>reportTitle} }"
        showNavButton="true"
        navButtonPress=".onPageReportExpenseNavButtonPress"
    >
        <content>
            <Table
                id="idExpenseRequestsReportTable"
                width="auto"
                items="{
                    path: '/ExpenseRequests',
                    sorter: {
                        path: 'SubmissionDate',
                        descending: true
                    }
                }"
                noDataText="{i18n>reportNoRequest}"
                class="sapUiResponsiveMargin"
            >
                <headerToolbar>
                    <OverflowToolbar id="idReportOverflowToolbar">
                        <Title
                            id="idRequestsReportToolbarTitle"
                            text="{= ${user>/Roles}.indexOf('finance') >= 0
                                    ? ${i18n>reportContentTitleFinance}
                                    : ${user>/Roles}.indexOf('manager') >= 0
                                        ? ${i18n>reportContentTitleManager}
                                        : ${i18n>reportContentTitle} }"
                        />
                        <ToolbarSpacer id="idReportToolbarSpacer" />
                        <SearchField
                            id="idReportSearchField"
                            width="30%"
                            placeholder="{i18n>placeholderSearchRequestNumberOrNotes}"
                            search=".onSearchFieldReportSearch"
                        />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="idRequestNumberColumn">
                        <Text
                            id="idRequestNumberColumnText"
                            text="{i18n>columnRequestNumber}"
                        />
                    </Column>
                    <Column
                        id="idSubmissionDateColumn"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                    >
                        <Text
                            id="idSubmissionDateColumnText"
                            text="{i18n>columnSubmissionDate}"
                        />
                    </Column>
                    <Column
                        id="idNotesColumn"
                        minScreenWidth="Desktop"
                        demandPopin="true"
                    >
                        <Text
                            id="idNotesColumnText"
                            text="{i18n>columnNotes}"
                        />
                    </Column>
                    <Column
                        id="idTotalRequestedAmountColumn"
                        hAlign="End"
                    >
                        <Text
                            id="idTotalRequestedAmountColumnText"
                            text="{i18n>columnTotalRequestedAmount}"
                        />
                    </Column>
                    <Column
                        id="idTotalAmountColumn"
                        hAlign="End"
                        visible="{= ${user>/Roles}.indexOf('finance') >= 0 }"
                    >
                        <Text
                            id="idTotalAmountColumnText"
                            text="{i18n>columnTotalAmount}"
                        />
                    </Column>
                    <Column
                        id="idTotalAcceptedAmountColumn"
                        hAlign="End"
                    >
                        <Text
                            id="idTotalAcceptedAmountColumnText"
                            text="{i18n>columnTotalAcceptedAmount}"
                        />
                    </Column>
                    <Column
                        id="idStatusColumn"
                        hAlign="Center"
                    >
                        <Text
                            id="idStatusColumnText"
                            text="{i18n>columnStatus}"
                        />
                    </Column>
                    <Column
                        id="idActionsReportColumn"
                        hAlign="End"
                        visible="{= ${user>/Roles}.indexOf('finance') >= 0 || ${user>/Roles}.indexOf('employee') >= 0 || ${user>/Roles}.indexOf('manager') >= 0}"
                    >
                        <Text
                            id="idActionsReportColumnText"
                            text="{i18n>columnAction}"
                        />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem
                        id="idReportColumnListItem"
                        type="Navigation"
                        press=".onReportItemPress"
                    >
                        <cells>
                            <ObjectIdentifier
                                id="idRequestNumberObjectIdentifier"
                                title="{RequestNumber}"
                            />
                            <Text
                                id="idSubmissionDateText"
                                text="{path: 'SubmissionDate', formatter: '.formatDateTime', targetType: 'any', type: 'sap.ui.model.odata.type.DateTimeOffset'}"
                            />
                            <Text
                                id="idNotesText"
                                text="{Notes}"
                            />
                            <ObjectNumber
                                id="idTotalRequestedAmountObjectNumber"
                                number="{
                                    path: 'TotalRequestedAmount',
                                    type: 'sap.ui.model.odata.type.Decimal',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2
                                    }
                                }"
                                unit="{Currency_code}"
                            />
                            <ObjectNumber
                                id="idTotalAmountObjectNumber"
                                number="{
                                    path: 'TotalAmount',
                                    type: 'sap.ui.model.odata.type.Decimal',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2
                                    }
                                }"
                                unit="{Currency_code}"
                                visible="{= ${user>/Roles}.indexOf('finance') >= 0 }"
                            />
                            <ObjectNumber
                                id="idTotalAcceptedAmountObjectNumber"
                                number="{
                                    path: 'TotalAcceptedAmount',
                                    type: 'sap.ui.model.odata.type.Decimal',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2
                                    }
                                }"
                                unit="{Currency_code}"
                                visible="{= ${path: 'Status', targetType: 'any'} === 'Reimbursed' }"
                            />
                            <ObjectStatus
                                id="idStatusObjectStatus"
                                text="{Status}"
                                state="{path: 'Status', formatter: '.formatStatusState'}"
                            />
                            <HBox
                                id="idReportActionsHBox"
                                justifyContent="End"
                            >
                                <Button
                                    id="idReportApproveButton"
                                    press=".onApproveButtonPress"
                                    icon="sap-icon://accept"
                                    type="Success"
                                    visible="{= ${user>/Roles}.indexOf('manager') >= 0 &amp;&amp; ( ${path: 'Status', targetType: 'any'} === 'Submitted' || ${path: 'Status', targetType: 'any'} === 'Inprogress' ) }"
                                    enabled="{= ${user>/Roles}.indexOf('manager') >= 0 &amp;&amp; ( ${path: 'Status', targetType: 'any'} === 'Submitted' || ${path: 'Status', targetType: 'any'} === 'Inprogress' ) }"
                                />
                                <Button
                                    id="idReportDeclineButton"
                                    press=".onDeclineButtonPress"
                                    class="sapUiSmallMarginBegin"
                                    icon="sap-icon://decline"
                                    type="Reject"
                                    visible="{= ${user>/Roles}.indexOf('manager') >= 0 &amp;&amp; ( ${path: 'Status', targetType: 'any'} === 'Submitted' || ${path: 'Status', targetType: 'any'} === 'Inprogress' ) }"
                                    enabled="{= ${user>/Roles}.indexOf('manager') >= 0 &amp;&amp; ( ${path: 'Status', targetType: 'any'} === 'Submitted' || ${path: 'Status', targetType: 'any'} === 'Inprogress' ) }"
                                />
                                <Button
                                    id="idReimbrseButton"
                                    icon="sap-icon://money-bills"
                                    type="Accept"
                                    press=".onButtonReimbursePress"
                                    tooltip="{i18n>btnReimburse}"
                                    enabled="{= ${path: 'Status', targetType: 'any'} === 'Approved' }"
                                    visible="{= ${user>/Roles}.indexOf('finance') >= 0 }"
                                />
                                <Button
                                    id="idDeleteButton"
                                    icon="sap-icon://delete"
                                    type="Negative"
                                    press=".onButtonDeletePress"
                                    tooltip="{i18n>btnDelete}"
                                    enabled="{= ${path: 'Status', targetType: 'any'} === 'Draft' }"
                                    visible="{= ${user>/Roles}.indexOf('employee') >= 0 }"
                                />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
