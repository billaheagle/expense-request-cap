<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="expenseapproval.controller.Report"
>
    <Page
        id="idReportPage"
        title="{i18n>reportTitle}"
        showNavButton="true"
        navButtonPress=".onPageReportExpenseNavButtonPress"
    >
        <content>
            <Table
                id="idExpenseRequestsReportTable"
                width="auto"
                items="{
                    path: '/ExpenseRequests',
                    sorter: {
                        path: 'SubmissionDate',
                        descending: true
                    }
                }"
                noDataText="{i18n>reportNoRequest}"
                class="sapUiResponsiveMargin"
            >
                <headerToolbar>
                    <OverflowToolbar id="idReportOverflowToolbar">
                        <Title
                            id="idRequestsReportToolbarTitle"
                            text="{i18n>reportContentTitle}"
                        />
                        <ToolbarSpacer id="idReportToolbarSpacer" />
                        <SearchField
                            id="idReportSearchField"
                            width="30%"
                            placeholder="{i18n>placeholderSearchRequestNumberOrNotes}"
                            search=".onSearchFieldReportSearch"
                        />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="idRequestNumberColumn">
                        <Text
                            id="idRequestNumberColumnText"
                            text="{i18n>columnRequestNumber}"
                        />
                    </Column>
                    <Column
                        id="idSubmissionDateColumn"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                    >
                        <Text
                            id="idSubmissionDateColumnText"
                            text="{i18n>columnSubmissionDate}"
                        />
                    </Column>
                    <Column
                        id="idNotesColumn"
                        minScreenWidth="Desktop"
                        demandPopin="true"
                    >
                        <Text
                            id="idNotesColumnText"
                            text="{i18n>columnNotes}"
                        />
                    </Column>
                    <Column
                        id="idTotalAmountColumn"
                        hAlign="End"
                    >
                        <Text
                            id="idTotalAmountColumnText"
                            text="{i18n>columnTotalAmount}"
                        />
                    </Column>
                    <Column
                        id="idStatusColumn"
                        hAlign="Center"
                    >
                        <Text
                            id="idStatusColumnText"
                            text="{i18n>columnStatus}"
                        />
                    </Column>
                    <Column
                        id="idActionsReportColumn"
                        hAlign="End"
                    >
                        <Text
                            id="idActionsReportColumnText"
                            text="{i18n>columnAction}"
                        />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem
                        id="idReportColumnListItem"
                        type="Navigation"
                        press=".onReportItemPress"
                    >
                        <cells>
                            <ObjectIdentifier
                                id="idRequestNumberObjectIdentifier"
                                title="{RequestNumber}"
                            />
                            <Text
                                id="idSubmissionDateText"
                                text="{path: 'SubmissionDate', formatter: '.formatDateTime', targetType: 'any', type: 'sap.ui.model.odata.type.DateTimeOffset'}"
                            />
                            <Text
                                id="idNotesText"
                                text="{Notes}"
                            />
                            <ObjectNumber
                                id="idTotalAmountObjectNumber"
                                number="{
                                    path: 'TotalAmount',
                                    type: 'sap.ui.model.odata.type.Decimal',
                                    formatOptions: {
                                        minFractionDigits: 2,
                                        maxFractionDigits: 2
                                    }
                                }"
                                unit="{Currency_code}"
                            />
                            <ObjectStatus
                                id="idStatusObjectStatus"
                                text="{Status}"
                                state="{path: 'Status', formatter: '.formatStatusState'}"
                            />
                            <HBox
                                id="idReportActionsHBox"
                                justifyContent="End"
                            >
                                <Button
                                    id="idReimbrseButton"
                                    icon="sap-icon://money-bills"
                                    type="Accept"
                                    press=".onButtonApprovePress"
                                    tooltip="{i18n>btnReimburse}"
                                />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
