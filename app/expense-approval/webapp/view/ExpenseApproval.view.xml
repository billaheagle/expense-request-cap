<mvc:View
    controllerName="expenseapproval.controller.ExpenseApproval"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
>
    <Page
        id="idExpenseApprovalPage"
        title="{i18n>homeTitle}"
    >
        <Panel id="idExpenseApprovalPanel">
            <content>
                <FlexBox
                    id="idTileFlexBox"
                    wrap="Wrap"
                    alignItems="Start"
                >
                    <GenericTile
                        id="idRequestGenericTile"
                        header="{i18n>homeRequestExpenseTile}"
                        press=".onGenericTileRequestPress"
                    >
                        <tileContent>
                            <TileContent id="idRequestTileContent">
                                <content>
                                    <Text
                                        id="idRequestANewExpenseText"
                                        text="{i18n>homeRequestExpenseTileContent}"
                                    />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        id="idReportGenericTile"
                        header="{i18n>homeReportExpenseTile}"
                        press=".onGenericTileReportPress"
                        class="sapUiSmallMarginBegin"
                    >
                        <tileContent>
                            <TileContent id="idReportTileContent">
                                <content>
                                    <Text
                                        id="idViewYourExpensesText"
                                        text="{i18n>homeReportExpenseTileContent}"
                                    />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <GenericTile
                        id="idApprovalGenericTile"
                        header="{i18n>homeApprovalExpenseTile}"
                        press=".onGenericTileApprovalPress"
                        class="sapUiSmallMarginBegin"
                    >
                        <tileContent>
                            <TileContent id="idApprovalTileContent">
                                <content>
                                    <Text
                                        id="idViewYourApprovalsText"
                                        text="{i18n>homeApprovalExpenseTileContent}"
                                    />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </FlexBox>
            </content>
        </Panel>
    </Page>
</mvc:View>
