{
  "name": "expense-approval",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds watch",
    "watch-expense-approval": "cds watch --open expenseapproval/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "admin@company.com": {
            "password": "123456",
            "roles": [
              "admin"
            ]
          },
          "manager@company.com": {
            "password": "123456",
            "roles": [
              "manager"
            ]
          },
          "finance@company.com": {
            "password": "123456",
            "roles": [
              "finance"
            ]
          },
          "employee@company.com": {
            "password": "123456",
            "roles": [
              "employee"
            ]
          },
          "it@company.com": {
            "password": "123456",
            "roles": [
              "*"
            ]
          }
        },
        "default": "employee@company.com"
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ]
}
